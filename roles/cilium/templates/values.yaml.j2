# replace kube-proxy
kubeProxyReplacement: true
k8sServiceHost: {{ k8s_api_host }}
k8sServicePort: 6443

# plage k3s not Cilium ones
ipam:
  mode: kubernetes

prometheus:
  enabled: true
dashboards:
  enabled: true
  label: grafana_dashboard
  labelValue: "1"
  annotations:
    grafana_folder: "Cilium"

resources:
  requests:
    cpu: 100m
    memory: 384Mi
  limits:
    cpu: 100m
    memory: 384Mi

operator:
  replicas: 1
  prometheus:
    enabled: true
  dashboards:
    enabled: true
    label: grafana_dashboard
    labelValue: "1"
    annotations:
      grafana_folder: "Cilium"
  resources:
    requests:
      cpu: 25m
      memory: 96Mi
    limits:
      memory: 256Mi

# hubble: obs network of cilium
hubble:
  enabled: true
  relay:
    enabled: true
    resources:
      requests:
        cpu: 25m
        memory: 64Mi
      limits:
        memory: 192Mi
  ui:
    enabled: false
  dashboards:
    enabled: true
    label: grafana_dashboard
    labelValue: "1"
    annotations:
      grafana_folder: "Cilium"
  metrics:
    enabled:
      - "drop:sourceContext=workload-name;destinationContext=workload-name" # rejected packet
      - "tcp" # flag TCP
      - "flow:sourceContext=workload-name;destinationContext=workload-name"
      - "icmp"

ingressController:
  enabled: true
  default: true
  loadbalancerMode: shared
  enforceHttps: false
  hostNetwork:
    enabled: true
    sharedListenerPort: 80
    httpPort: 80
    httpsPort: 443

envoy:
  prometheus:
    enabled: true
    port: "9964"
  securityContext:
    capabilities:
      keepCapNetBindService: true
      envoy:
        - NET_ADMIN
        - SYS_ADMIN
        - NET_BIND_SERVICE
  resources:
    requests:
      cpu: 100m
      memory: 192Mi
    limits:
      cpu: 100m
      memory: 192Mi
