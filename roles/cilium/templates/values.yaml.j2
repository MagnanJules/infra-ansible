# replace kube-proxy
kubeProxyReplacement: true
k8sServiceHost: {{ k8s_api_host }}
k8sServicePort: 6443

# plage k3s not Cilium ones
ipam:
  mode: kubernetes

prometheus:
  enabled: true
dashboards:
  enabled: true

operator:
  replicas: 1
  prometheus:
    enabled: true
  dashboards:
    enabled: true

# hubble: obs network of cilium
hubble:
  relay:
    enabled: true
  ui:
    enabled: true
  metrics:
    enabled:
      - drop # rejected packet
      - tcp # flag TCP
      - flow
      - port-distribution
      - icmp

ingressController:
  enabled: true
  default: true
  loadbalancerMode: shared
  enforceHttps: false
  hostNetwork:
    enabled: true
    sharedListenerPort: 80
    httpPort: 80
    httpsPort: 443

envoy:
  securityContext:
    capabilities:
      keepCapNetBindService: true
      envoy:
        - NET_ADMIN
        - SYS_ADMIN
        - NET_BIND_SERVICE
